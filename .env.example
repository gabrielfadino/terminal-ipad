# Copie este arquivo para ".env" e troque a senha.
# Use uma senha forte: o Terminal fica acessível pela internet (Funnel).
SENHA=troque-esta-senha

# Desconecta depois de X minutos sem uso (assistir no Modo Cinema conta como uso)
SESSAO_OCIOSA_MIN=30

# Desconecta depois de X horas desde a entrada, mesmo em uso
SESSAO_MAX_HORAS=8
